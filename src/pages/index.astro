---
import '../styles.css';
import seed from '../../data/seed.json';
---
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Bentstraw — forgotten past, tomorrow's tech</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap">
</head><body>
<nav class="top"><a class="brand" href="/">Bentstraw</a><a href="/quiz/">Quiz</a><a href="/search/">Search</a></nav>
<h1>Bentstraw</h1>
<p class="meta">Social discovery of forgotten past + tomorrow's tech. Tools found for you. Expands daily.</p>
<p><input id="q" placeholder="search tools, skills, repos, models…" autocomplete="off"><div id="hits" class="grid"></div></p>
<div class="grid">{seed.map((r:any) => <div class="card"><h3>{r.name}</h3><p>{r.blurb}</p><p class="meta">{r.id} · {r.past ? 'past' : 'future'}</p><span><button class="btn" data-vote={r.id}>👍 <b data-cnt={r.id}>0</b></button></span></div>)}</div>
<p><a class="btn primary" href="/quiz/">Take the match quiz</a> <a class="btn" href="/search/">Full search (Orama)</a></p>
<footer>Bentstraw · brutalist · PGlite + Orama</footer>
<script type="module">
import { create, load, search } from 'https://cdn.jsdelivr.net/npm/@orama/orama@latest/+esm';
const votes = JSON.parse(localStorage.getItem('bent-votes')||'{}');
const paint=()=>document.querySelectorAll('[data-cnt]').forEach(e=>e.textContent=votes[e.getAttribute('data-cnt')]||0);
paint();
document.querySelectorAll('[data-vote]').forEach(b=>b.onclick=()=>{const id=b.getAttribute('data-vote');votes[id]=(votes[id]||0)+1;localStorage.setItem('bent-votes',JSON.stringify(votes));paint();});
const res = await fetch('/orama.json').then(r=>r.json()).catch(()=>null);
let db=null; if(res){db=create({schema:{id:'string',kind:'string',name:'string',blurb:'string',tags:'string[]'}});await load(db,res);}
const q=document.getElementById('q'), hits=document.getElementById('hits');
q.oninput=async()=>{ if(!db||!q.value){hits.innerHTML='';return;} const r=await search(db,{term:q.value,limit:8}); hits.innerHTML=r.hits.map(h=>`<div class="card"><h3>${h.document.name}</h3><p>${h.document.blurb}</p><p class="meta">${h.document.id}</p></div>`).join(''); };
</script>
</body></html>
