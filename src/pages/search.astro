---
import Base from '../layouts/Base.astro';
---
<Base title="Search — Bentstraw">
  <h1>Search</h1>
  <p class="meta">Orama full-text now, vector when 384-dim embeddings land.</p>
  <p><input id="q" placeholder="e.g. forgotten os, agent browser, embeddings…" /></p>
  <div id="hits" class="grid"></div>
  <script type="module">
    import { create, load, search } from 'https://cdn.jsdelivr.net/npm/@orama/orama@latest/+esm';
    const db = create({ schema: { id: 'string', kind: 'string', name: 'string', blurb: 'string', tags: 'string[]' } });
    await load(db, await fetch('/orama.json').then((r) => r.json()));
    const q = document.getElementById('q');
    const hits = document.getElementById('hits');
    q.oninput = async () => {
      if (!q.value) { hits.innerHTML = ''; return; }
      const r = await search(db, { term: q.value, limit: 20 });
      hits.innerHTML = r.hits.map((h) => `<div class="card"><h3>${h.document.name}</h3><p>${h.document.blurb}</p><p class="meta">${h.document.id}</p></div>`).join('');
    };
  </script>
</Base>
